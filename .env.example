# ============================================================
#  ACS — Nike CBD Data Automation
#  Copy this file to `.env` and fill in your own values.
#  `.env` is git-ignored and must NEVER be committed.
# ============================================================

# -------------------- ACS CREDENTIALS --------------------
ACS_USER=your.email@example.com
ACS_PASS=your_password_here

# -------------------- FILE / SSIS PATHS -------------------
# Target folder for the cleaned Excel output
ASC_FOLDER_PATH=D:\path\to\ACS\downloads
# Full path to the .dtsx SSIS package (leave blank to skip the SSIS step)
ASC_SSIS_PATH=D:\path\to\ACS_Load.dtsx

# -------------------------- FLOW ACS ----------------------
# Base directory where the ACS scripts live
ACS-FLOW_BASE_PATH=D:\path\to\PPS,ACS,WISDOM\ACS
# Comma-separated list of scripts to run in order
ACS-FLOW_SCRIPTS="FetchData.py,
                  CleanFile.py"
# Log file written to the desktop after each run
ACS-FLOW_LOG_FILE=ACS_flow_Log.txt
# Label used in the log to identify this run
ACS-FLOW_RUN_ID=ACS-DAILY
# Where the log is written (defaults to ~/Desktop)
DESKTOP_PATH=C:\Users\YourName\Desktop
